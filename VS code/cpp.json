            "struct DSU {",
            "\tvector<int> parent, size;",
            "",
            "\tDSU(int n) : parent(n), size(n, 1) {",
            "\t\tiota(parent.begin(), parent.end(), 0);",
            "\t}",
            "",
            "\tint find(int node) {",
            "\t\treturn parent[node] == node ? node : parent[node] = find(parent[node]);",
            "\t}",
            "",
            "\tbool unite(int a, int b) {",
            "\t\ta = find(a);",
            "\t\tb = find(b);",
            "\t\tif (a == b) return false;",
            "\t\tif (size[a] < size[b]) swap(a, b);",
            "\t\tparent[b] = a;",
            "\t\tsize[a] += size[b];",
            "\t\treturn true;",
            "\t}",
            "};"
        ],
        "description": "Union-find with path compression and union by size"
